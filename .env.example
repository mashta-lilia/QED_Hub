# Copy to .env to override docker-compose defaults: `cp .env.example .env`
# All values below are the defaults baked into docker-compose.yml.

# Postgres
POSTGRES_USER=qed
POSTGRES_PASSWORD=qed
POSTGRES_DB=qed_hub
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend (JWT key must be >= 32 chars)
BACKEND_PORT=4000
JWT_SYMMETRIC_KEY=dev-local-jwt-secret-please-change-0123456789
CLIENT_ORIGIN=http://localhost:8080

# Frontend (served by nginx, proxies /api -> backend)
FRONTEND_PORT=8080

# Test admin seeded by: docker compose --profile seed run --rm seed
SEED_EMAIL=admin@gmail.com
SEED_PASSWORD=admin
SEED_NAME=admin
